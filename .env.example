# Copy to .env; never put real credentials in this tracked template.
TYPEDB_ADDRESS=localhost:1730
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=password
TYPEDB_DATABASE=dividend_benchmark
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# config/models.json supplies explicit Claude, OpenAI and OpenRouter models.
# Optional: MODELS_JSON overrides that catalogue with a JSON list of definitions.
# Every live model needs input/output prices and price_date verified within14 days.
# One persistent EUR30 allowance is shared across providers and server restarts.
# It cannot be increased through an environment setting.

# Optional hybrid retrieval; lexical BM25 is used when unset.
# EMBEDDING_BASE_URL=https://YOUR_PROVIDER/v1
# EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
# EMBEDDING_API_KEY=
# EMBEDDING_INPUT_PRICE_PER_MILLION=0.02
# EMBEDDING_PRICE_DATE=YYYY-MM-DD
