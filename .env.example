# Copy this file to .env. Keep .env out of version control.
TYPEDB_ADDRESS=localhost:1730
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=password
TYPEDB_DATABASE=dividend_benchmark

# Empty catalogue: reference walkthroughs work, live comparisons require configuration.
# Set any OpenAI-compatible model endpoint; model IDs are explicit, never guessed.
# MODELS_JSON='[{"id":"primary","name":"My model","model":"YOUR_MODEL_ID","base_url":"https://YOUR_PROVIDER/v1","api_key_env":"MODEL_API_KEY","provider":"OpenAI-compatible"}]'
# MODEL_API_KEY=

# Local Ollama example (after downloading a model yourself):
# MODELS_JSON='[{"id":"local","name":"Local model","model":"YOUR_LOCAL_MODEL","base_url":"http://localhost:11434/v1","api_key_env":"LOCAL_MODEL_API_KEY","provider":"Local"}]'

# Optional hybrid retrieval. Without an embedding endpoint the run manifest says lexical.
# EMBEDDING_BASE_URL=https://YOUR_PROVIDER/v1
# EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
# EMBEDDING_API_KEY=

# Optional dated pricing on each MODELS_JSON entry:
# input_price_per_million, output_price_per_million,
# cached_input_price_per_million, price_date (YYYY-MM-DD).
# Cost remains unavailable unless complete usage and applicable prices are provided.
